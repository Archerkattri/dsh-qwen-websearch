  "description": "Qwen Token Plan web search provider for DeepSeek Harness: native web_search with Qwen3.8 Flash summaries and source URLs",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
